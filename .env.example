# 主 API 地址，不要带 /api；同机部署可使用 http://localhost:4001。
MAIN_API_BASE_URL=http://localhost:4001
# Worker 实例唯一标识；多实例部署时每个实例必须不同。
WORKER_ID=local-dev-01
# 与主 API 的 COMPOSE_WORKER_API_KEY 保持完全一致。
# Worker 启动时会自动加载项目根目录下的 .env。
COMPOSE_WORKER_API_KEY=<replace-with-worker-api-key>
# 三类任务使用独立槽位；设为 0 可关闭该类任务。合成也兼容旧变量 WORKER_MAX_SLOTS。
WORKER_COMPOSE_MAX_SLOTS=4
WORKER_AIMV_MAX_SLOTS=20
WORKER_CLEANUP_MAX_SLOTS=2
