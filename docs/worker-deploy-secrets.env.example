# 复制到服务器：/tmp/worker-deploy-secrets.env 后 chmod 600
# 填完占位符再交给服务器 Agent 执行 docs/AGENT-DEPLOY-WORKER.md

# test / prod / test,prod
WORKER_ENVS=test

REPO_WORKER=https://github.com/msea-ai/mv-studio-work.git
WORKER_BRANCH=main
AI_USER=aistudio
AI_HOME=/opt/ai-studio

# ── 测试（WORKER_ENVS 含 test 时必填）──────────────────────────────────────
# 不要带 /api；同机 API 用 http://127.0.0.1:4001
TEST_MAIN_API_BASE_URL=http://<测试API主机>:4001
TEST_COMPOSE_WORKER_API_KEY=<与测试API的COMPOSE_WORKER_API_KEY一致>
TEST_WORKER_ID=ubuntu-test-01
TEST_WORKER_MAX_SLOTS=2

# ── 生产（WORKER_ENVS 含 prod 时必填）──────────────────────────────────────
PROD_MAIN_API_BASE_URL=https://api.aimv.com
PROD_COMPOSE_WORKER_API_KEY=<与生产API的COMPOSE_WORKER_API_KEY一致>
PROD_WORKER_ID=ubuntu-prod-01
PROD_WORKER_MAX_SLOTS=2

# ── 可选：GitHub self-hosted runner ───────────────────────────────────────
RUNNER_TOKEN=
RUNNER_REPO=msea-ai/mv-studio-work
RUNNER_LABELS=self-hosted,mv-studio-worker,test
